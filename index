<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>課堂小組討論抽題卡</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Noto Sans TC & Fredoka for playful rounded hand-drawn feel -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Noto+Sans+TC:wght@700;900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --ink: #1a1a1a;
      --mint-bg: #d8f3f0;
      --paper-bg: #fffdf7;
      --pink: #f48fb1;
      --lavender-pink: #f8bbd0;
      --coral: #ef5350;
      --sky: #29b6f6;
      --peach: #ffab76;
      --yellow: #ffe066;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: 'Noto Sans TC', 'Fredoka', sans-serif;
      background-color: #fef9ef;
      background-image:
        radial-gradient(#e6dec8 2px, transparent 2px),
        radial-gradient(#e6dec8 2px, #fef9ef 2px);
      background-size: 40px 40px;
      background-position: 0 0, 20px 20px;
      color: var(--ink);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Hand-drawn organic doodle border styles */
    .doodle-box {
      border: 4px solid var(--ink);
      border-radius: 24px 18px 22px 16px / 18px 24px 16px 22px;
      box-shadow: 6px 6px 0px var(--ink);
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
    }

    .doodle-box-sm {
      border: 3px solid var(--ink);
      border-radius: 16px 12px 15px 13px / 13px 15px 12px 16px;
      box-shadow: 4px 4px 0px var(--ink);
      transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.18s ease;
    }

    .doodle-btn {
      border: 3.5px solid var(--ink);
      border-radius: 18px 14px 17px 15px / 15px 17px 14px 18px;
      box-shadow: 4px 4px 0px var(--ink);
      font-weight: 900;
      transition: all 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
      cursor: pointer;
    }

    .doodle-btn:hover:not(:disabled) {
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0px var(--ink);
    }

    .doodle-btn:active:not(:disabled) {
      transform: translate(3px, 3px);
      box-shadow: 1px 1px 0px var(--ink);
    }

    .doodle-btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* 3D Card Flip Mechanics */
    .perspective-container {
      perspective: 1200px;
    }

    .mystery-card {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      transform-style: preserve-3d;
      transition: transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
      cursor: pointer;
    }

    .mystery-card:hover:not(.is-drawn):not(.is-shuffling) {
      transform: translateY(-10px) rotate(-1.5deg) scale(1.03);
    }

    .mystery-card.is-flipped {
      transform: rotateY(180deg);
    }

    .mystery-card.is-drawn {
      cursor: pointer;
    }

    .card-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border: 4px solid var(--ink);
      border-radius: 26px 20px 24px 18px / 20px 26px 18px 24px;
      box-shadow: 7px 7px 0px var(--ink);
      overflow: hidden;
    }

    .card-back {
      background: linear-gradient(135deg, #ffe066 0%, #ffca28 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .card-back-pattern {
      position: absolute;
      inset: 10px;
      border: 3px dashed var(--ink);
      border-radius: 18px;
      pointer-events: none;
    }

    .card-front {
      transform: rotateY(180deg);
      display: flex;
      flex-direction: column;
      padding: 12px;
    }

    .card-front-inner {
      flex: 1;
      background-color: var(--mint-bg);
      border: 3.5px solid var(--ink);
      border-radius: 16px 12px 15px 12px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    /* Shuffle animation */
    @keyframes shuffleWiggle {
      0% { transform: translate(0, 0) rotate(0deg); }
      20% { transform: translate(-18px, -12px) rotate(-8deg) scale(0.95); }
      40% { transform: translate(20px, 8px) rotate(9deg) scale(1.04); }
      60% { transform: translate(-14px, 10px) rotate(-6deg) scale(0.98); }
      80% { transform: translate(12px, -8px) rotate(5deg) scale(1.02); }
      100% { transform: translate(0, 0) rotate(0deg) scale(1); }
    }

    .is-shuffling {
      animation: shuffleWiggle 0.65s ease-in-out;
    }

    /* Floating doodle animations */
    @keyframes floatSlow {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-6px) rotate(2deg); }
    }

    .float-doodle {
      animation: floatSlow 3.2s ease-in-out infinite;
    }

    @keyframes pulseUrgent {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }

    .timer-urgent {
      animation: pulseUrgent 0.7s ease-in-out infinite;
      color: #d32f2f !important;
    }

    /* Group pill active glow */
    .group-pill.active {
      background-color: #ffe066;
      transform: translate(-2px, -3px) scale(1.05);
      box-shadow: 5px 6px 0px var(--ink);
    }

    /* Modal Backdrop */
    .modal-backdrop {
      background-color: rgba(26, 26, 26, 0.65);
      backdrop-filter: blur(4px);
    }

    @keyframes popIn {
      0% { transform: scale(0.75) rotate(-2deg); opacity: 0; }
      70% { transform: scale(1.03) rotate(0.5deg); opacity: 1; }
      100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    .modal-pop {
      animation: popIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    /* Confetti Canvas */
    #confetti-canvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 100;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-thumb {
      background: #1a1a1a;
      border-radius: 999px;
    }
  </style>
</head>
<body class="flex flex-col justify-between p-3 sm:p-5 lg:p-6">
  <!-- Confetti Overlay -->
  <canvas id="confetti-canvas"></canvas>

  <!-- TOP HEADER & CLASSROOM CONTROLS -->
  <header class="max-w-7xl w-full mx-auto mb-4">
    <div class="doodle-box bg-white px-4 py-3 sm:px-6 sm:py-4 flex flex-wrap items-center justify-between gap-3">
      <!-- Title & Mascot -->
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-[#ffe066] border-[3.5px] border-[#1a1a1a] flex items-center justify-center shadow-[3px_3px_0_#1a1a1a] float-doodle">
          <svg viewBox="0 0 64 64" class="w-9 h-9">
            <path d="M32 8 C20 8 13 17 13 27 C13 34 17 39 21 43 L22 49 L42 49 L43 43 C47 39 51 34 51 27 C51 17 44 8 32 8 Z" fill="#FFF176" stroke="#1a1a1a" stroke-width="4" stroke-linejoin="round"/>
            <rect x="22" y="49" width="20" height="5" rx="2.5" fill="#29B6F6" stroke="#1a1a1a" stroke-width="3.5"/>
            <rect x="24" y="54" width="16" height="5" rx="2.5" fill="#29B6F6" stroke="#1a1a1a" stroke-width="3.5"/>
            <path d="M27 33 Q32 25 37 33" fill="none" stroke="#1a1a1a" stroke-width="3.5" stroke-linecap="round"/>
            <line x1="32" y1="2" x2="32" y2="5" stroke="#1a1a1a" stroke-width="3.5" stroke-linecap="round"/>
            <line x1="8" y1="15" x2="11" y2="17" stroke="#1a1a1a" stroke-width="3.5" stroke-linecap="round"/>
            <line x1="56" y1="15" x2="53" y2="17" stroke="#1a1a1a" stroke-width="3.5" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-black tracking-wide text-[#1a1a1a]">
            小組討論抽題卡
          </h1>
          <p class="text-xs sm:text-sm font-bold text-gray-600">
            先選擇小組，再點擊一張神秘卡片抽取討論題目！
          </p>
        </div>
      </div>

      <!-- Mini Global Timer & Action Buttons -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <!-- Quick Timer Pill on Board -->
        <div id="mini-timer-box" onclick="openTimerOnlyModal()" title="點擊展開計時器"
             class="doodle-box-sm bg-[#d8f3f0] px-3 py-1.5 sm:px-4 sm:py-2 flex items-center gap-2 cursor-pointer hover:bg-[#c2ece7]">
          <svg viewBox="0 0 24 24" class="w-5 h-5 sm:w-6 sm:h-6 shrink-0" fill="none" stroke="#1a1a1a" stroke-width="2.6" stroke-linecap="round">
            <circle cx="12" cy="13" r="8"/>
            <path d="M12 9v4l2.5 1.5"/>
            <path d="M9 2h6"/>
            <path d="M12 2v3"/>
          </svg>
          <span id="mini-timer-display" class="font-black text-lg sm:text-xl tracking-wider tabular-nums">05:00</span>
          <button id="mini-timer-toggle" onclick="event.stopPropagation(); toggleTimer();"
                  class="ml-1 px-2.5 py-0.5 text-xs font-black rounded-lg border-2 border-[#1a1a1a] bg-[#ffe066] hover:bg-[#ffd54f]">
            開始
          </button>
        </div>

        <!-- Shuffle Button -->
        <button id="btn-shuffle" onclick="shuffleCards()"
                class="doodle-btn bg-[#81d4fa] hover:bg-[#4fc3f7] px-3.5 py-2 text-sm sm:text-base flex items-center gap-1.5">
          <span>🔀</span>
          <span>洗牌</span>
        </button>

        <!-- Reset All Button -->
        <button onclick="confirmResetAll()"
                class="doodle-btn bg-[#ffab76] hover:bg-[#ff9854] px-3.5 py-2 text-sm sm:text-base flex items-center gap-1.5">
          <span>🔄</span>
          <span>全部重置</span>
        </button>

        <!-- Sound Mute/Unmute Toggle -->
        <button id="btn-sound" onclick="toggleSound()" title="切換音效"
                class="doodle-btn bg-[#f8bbd0] hover:bg-[#f48fb1] p-2 sm:px-3 sm:py-2 text-base sm:text-lg flex items-center gap-1">
          <span id="sound-icon">🔊</span>
          <span class="hidden md:inline text-sm">音效開</span>
        </button>
      </div>
    </div>
  </header>

  <!-- GROUP SELECTOR BAR -->
  <section class="max-w-7xl w-full mx-auto mb-5">
    <div class="doodle-box bg-white/95 px-4 py-3 sm:px-5 sm:py-3.5">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
        <div class="flex items-center gap-2">
          <span class="inline-block px-2.5 py-0.5 bg-[#1a1a1a] text-white text-xs sm:text-sm font-black rounded-full">
            STEP 1
          </span>
          <h2 class="text-base sm:text-lg font-black">
            目前抽卡小組：<span id="current-group-label" class="text-[#e91e63] underline decoration-wavy decoration-2">第 1 組</span>
          </h2>
        </div>

        <!-- Add / Remove Group Controls -->
        <div class="flex items-center gap-1.5 text-xs sm:text-sm">
          <button onclick="removeGroup()" class="px-2.5 py-1 rounded-xl border-2 border-[#1a1a1a] bg-gray-100 hover:bg-gray-200 font-black" title="減少一組">
            － 組別
          </button>
          <button onclick="addGroup()" class="px-2.5 py-1 rounded-xl border-2 border-[#1a1a1a] bg-gray-100 hover:bg-gray-200 font-black" title="增加一組">
            ＋ 組別
          </button>
        </div>
      </div>

      <!-- Group Pills Container -->
      <div id="groups-container" class="flex flex-wrap gap-2.5 sm:gap-3">
        <!-- Rendered dynamically by JS -->
      </div>
    </div>
  </section>

  <!-- MAIN 5-CARD DECK STAGE -->
  <main class="max-w-7xl w-full mx-auto flex-1 flex flex-col justify-center my-2">
    <div class="flex items-center justify-between mb-3 px-1">
      <div class="flex items-center gap-2">
        <span class="inline-block px-2.5 py-0.5 bg-[#1a1a1a] text-white text-xs sm:text-sm font-black rounded-full">
          STEP 2
        </span>
        <span id="instruction-banner" class="text-sm sm:text-base lg:text-lg font-black text-[#1a1a1a]">
          請「第 1 組」點擊下方任一張神秘卡片！
        </span>
      </div>
      <span id="remaining-count" class="text-xs sm:text-sm font-black bg-white px-3 py-1 rounded-full border-2 border-[#1a1a1a]">
        剩餘卡片：5 / 5 張
      </span>
    </div>

    <!-- 5 Cards Responsive Grid -->
    <div id="cards-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5 lg:gap-6">
      <!-- Cards rendered dynamically by JS -->
    </div>
  </main>

  <!-- FOOTER HINT -->
  <footer class="max-w-7xl w-full mx-auto mt-6 text-center text-xs sm:text-sm font-bold text-gray-500">
    💡 提示：點擊已翻開的卡片可再次放大檢視題目與啟動 5 分鐘倒數計時器
  </footer>

  <!-- ===================================================================== -->
  <!-- FOCUS MODAL: ENLARGED DISCUSSION CARD + 5-MINUTE COUNTDOWN TIMER      -->
  <!-- ===================================================================== -->
  <div id="focus-modal" class="fixed inset-0 z-50 hidden modal-backdrop flex items-center justify-center p-3 sm:p-6">
    <div id="focus-modal-card" class="modal-pop w-full max-w-4xl border-[5px] border-[#1a1a1a] rounded-[30px] shadow-[10px_10px_0_#1a1a1a] p-3.5 sm:p-6 transition-colors duration-300"
         style="background-color: #f48fb1;">
      <!-- Inner Mint-Blue Doodle Board matching uploaded images -->
      <div class="bg-[#d8f3f0] border-[4px] border-[#1a1a1a] rounded-[22px] p-4 sm:p-7 lg:p-8 relative flex flex-col justify-between min-h-[430px] sm:min-h-[480px]">

        <!-- Top Bar inside Card: Group Badge + 5 min Stopwatch Badge + Close -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <div class="flex items-center gap-2.5">
            <span id="modal-group-badge" class="px-4 py-1.5 rounded-full bg-[#ffe066] border-[3px] border-[#1a1a1a] shadow-[3px_3px_0_#1a1a1a] text-base sm:text-xl font-black">
              第 1 組 討論題目
            </span>
            <span id="modal-card-number-badge" class="px-3 py-1 rounded-full bg-white border-[3px] border-[#1a1a1a] text-sm sm:text-base font-black">
              題卡 #1
            </span>
          </div>

          <!-- Top-right Stopwatch Icon matching uploaded slides (updated to 5 min) -->
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-1.5 bg-white/90 px-3 py-1 rounded-full border-[3px] border-[#1a1a1a]">
              <svg viewBox="0 0 36 36" class="w-7 h-7 sm:w-8 sm:h-8">
                <circle cx="18" cy="20" r="13" fill="none" stroke="#1a1a1a" stroke-width="3.5"/>
                <line x1="14" y1="3" x2="22" y2="3" stroke="#1a1a1a" stroke-width="3.5" stroke-linecap="round"/>
                <line x1="18" y1="3" x2="18" y2="7" stroke="#1a1a1a" stroke-width="3.5"/>
                <line x1="27" y1="8" x2="30" y2="11" stroke="#1a1a1a" stroke-width="3.5" stroke-linecap="round"/>
                <text x="18" y="24" text-anchor="middle" font-size="11" font-weight="900" fill="#1a1a1a">5m</text>
              </svg>
              <span class="font-black text-sm sm:text-base">限時 5 分鐘</span>
            </div>

            <button onclick="closeFocusModal()" title="返回牌桌"
                    class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white hover:bg-red-100 border-[3px] border-[#1a1a1a] shadow-[3px_3px_0_#1a1a1a] flex items-center justify-center font-black text-xl">
              ✕
            </button>
          </div>
        </div>

        <!-- Middle Content: Illustration + Big Clear Question Text -->
        <div id="modal-content-layout" class="my-auto py-2 sm:py-4 grid grid-cols-1 md:grid-cols-12 items-center gap-4 sm:gap-6">
          <!-- Illustration Slot -->
          <div id="modal-illustration" class="md:col-span-5 flex items-center justify-center max-h-[210px] sm:max-h-[260px]">
            <!-- Injected SVG -->
          </div>

          <!-- Question Text Slot -->
          <div id="modal-question-wrapper" class="md:col-span-7 flex flex-col justify-center">
            <h2 id="modal-question-text" class="text-2xl sm:text-3xl lg:text-4xl font-black leading-snug sm:leading-normal text-[#1a1a1a] tracking-wide">
              1. 如果你可以選擇任意城市定居，你會選擇哪裏？為什麼？
            </h2>
          </div>
        </div>

        <!-- Bottom Integrated 5-Minute Countdown Timer Panel -->
        <div class="mt-4 pt-4 border-t-[3px] border-dashed border-[#1a1a1a]/40">
          <div class="bg-white border-[3.5px] border-[#1a1a1a] rounded-2xl p-3 sm:p-4 shadow-[4px_4px_0_#1a1a1a] flex flex-col sm:flex-row items-center justify-between gap-3">
            <!-- Digital Countdown & Progress Bar -->
            <div class="flex items-center gap-3 sm:gap-4 w-full sm:w-auto justify-center sm:justify-start">
              <div class="relative w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center shrink-0">
                <svg class="w-full h-full -rotate-90" viewBox="0 0 64 64">
                  <circle cx="32" cy="32" r="26" fill="#f3f4f6" stroke="#1a1a1a" stroke-width="4"/>
                  <circle id="timer-ring" cx="32" cy="32" r="26" fill="none" stroke="#26a69a" stroke-width="6"
                          stroke-dasharray="163.36" stroke-dashoffset="0" stroke-linecap="round"/>
                </svg>
                <span class="absolute text-lg sm:text-xl">⏱️</span>
              </div>

              <div>
                <div class="text-xs font-black text-gray-500 uppercase tracking-wider">小組討論倒數計時</div>
                <div id="modal-timer-display" class="text-3xl sm:text-4xl lg:text-5xl font-black tabular-nums tracking-wider text-[#1a1a1a]">
                  05:00
                </div>
              </div>
            </div>

            <!-- Timer Control Buttons -->
            <div class="flex flex-wrap items-center justify-center gap-2">
              <button id="modal-timer-start-btn" onclick="toggleTimer()"
                      class="doodle-btn bg-[#81c784] hover:bg-[#66bb6a] px-4 py-2 sm:px-5 sm:py-2.5 text-base sm:text-lg flex items-center gap-1.5">
                <span id="modal-timer-btn-icon">▶️</span>
                <span id="modal-timer-btn-text">開始計時</span>
              </button>

              <button onclick="adjustTimer(-60)" title="減少 1 分鐘"
                      class="doodle-btn bg-gray-100 hover:bg-gray-200 px-3 py-2 text-sm sm:text-base">
                -1分
              </button>

              <button onclick="adjustTimer(60)" title="增加 1 分鐘"
                      class="doodle-btn bg-gray-100 hover:bg-gray-200 px-3 py-2 text-sm sm:text-base">
                +1分
              </button>

              <button onclick="resetTimer(300)" title="重設為 5 分鐘"
                      class="doodle-btn bg-[#ffe066] hover:bg-[#ffd54f] px-3.5 py-2 text-sm sm:text-base">
                重設 5:00
              </button>

              <button onclick="closeFocusModal()"
                      class="doodle-btn bg-[#29b6f6] hover:bg-[#03a9f4] px-4 py-2 text-sm sm:text-base text-white" style="text-shadow: 1px 1px 0 #1a1a1a;">
                下一組抽卡 ➜
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ===================================================================== -->
  <!-- CUSTOM CONFIRMATION / MESSAGE MODAL (NO alert() or confirm())         -->
  <!-- ===================================================================== -->
  <div id="dialog-modal" class="fixed inset-0 z-[60] hidden modal-backdrop flex items-center justify-center p-4">
    <div class="modal-pop doodle-box bg-white max-w-md w-full p-6 text-center">
      <div id="dialog-icon" class="text-5xl mb-3">🔄</div>
      <h3 id="dialog-title" class="text-2xl font-black mb-2">確定要全部重置嗎？</h3>
      <p id="dialog-message" class="text-gray-700 font-bold mb-6">
        這將會清除所有小組的抽卡紀錄，並將五張卡片重新蓋上洗牌！
      </p>
      <div class="flex items-center justify-center gap-3">
        <button id="dialog-cancel-btn" onclick="closeDialog()"
                class="doodle-btn bg-gray-200 hover:bg-gray-300 px-5 py-2.5 text-base">
          取消
        </button>
        <button id="dialog-confirm-btn"
                class="doodle-btn bg-[#ef5350] text-white hover:bg-[#e53935] px-5 py-2.5 text-base">
          確定重置
        </button>
      </div>
    </div>
  </div>

  <script>
    /* =========================================================================
       1. WEB AUDIO API LIVELY SOUND SYNTHESIZER (NO EXTERNAL AUDIO FILES)
       ========================================================================= */
    class ClassroomSoundFX {
      constructor() {
        this.ctx = null;
        this.muted = false;
      }

      init() {
        if (!this.ctx) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContext();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      playTone(freq, type = 'sine', duration = 0.15, startTimeOffset = 0, volume = 0.25, slideToFreq = null) {
        if (this.muted) return;
        try {
          this.init();
          const now = this.ctx.currentTime + startTimeOffset;
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();

          osc.type = type;
          osc.frequency.setValueAtTime(freq, now);
          if (slideToFreq) {
            osc.frequency.exponentialRampToValueAtTime(slideToFreq, now + duration);
          }

          gain.gain.setValueAtTime(0.001, now);
          gain.gain.exponentialRampToValueAtTime(volume, now + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

          osc.connect(gain);
          gain.connect(this.ctx.destination);

          osc.start(now);
          osc.stop(now + duration + 0.02);
        } catch (e) {
          // Ignore audio context block before user gesture
        }
      }

      // Soft bubble pop on card hover / button click
      playPop() {
        this.playTone(420, 'sine', 0.09, 0, 0.15, 680);
      }

      // Group selection marimba tap
      playSelectGroup() {
        this.playTone(523.25, 'triangle', 0.11, 0, 0.22); // C5
        this.playTone(659.25, 'triangle', 0.14, 0.06, 0.22); // E5
      }

      // Card shuffle swish-boing
      playShuffle() {
        const notes = [330, 392, 440, 523, 587, 659];
        notes.forEach((n, idx) => {
          this.playTone(n, 'triangle', 0.08, idx * 0.055, 0.18, n * 1.15);
        });
      }

      // Magical celebratory arpeggio when flipping a card!
      playCardReveal() {
        // Upbeat major 9th arpeggio + sparkle chime
        const melody = [
          { freq: 523.25, time: 0.00, dur: 0.16, type: 'triangle' }, // C5
          { freq: 659.25, time: 0.08, dur: 0.16, type: 'triangle' }, // E5
          { freq: 783.99, time: 0.16, dur: 0.16, type: 'triangle' }, // G5
          { freq: 1046.50, time: 0.24, dur: 0.35, type: 'sine' },    // C6
          { freq: 1318.51, time: 0.32, dur: 0.40, type: 'sine' }     // E6
        ];
        melody.forEach(note => {
          this.playTone(note.freq, note.type, note.dur, note.time, 0.25);
        });
      }

      // Timer start / pause click
      playTimerClick(isStarting) {
        if (isStarting) {
          this.playTone(587.33, 'sine', 0.12, 0, 0.22); // D5
          this.playTone(880.00, 'sine', 0.18, 0.08, 0.22); // A5
        } else {
          this.playTone(659.25, 'sine', 0.12, 0, 0.2);
          this.playTone(440.00, 'sine', 0.16, 0.08, 0.2);
        }
      }

      // Gentle tick-tock in final 10 seconds
