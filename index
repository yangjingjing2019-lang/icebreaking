                  <!-- Question Preview -->
                  <div class="text-center">
                    <p class="text-xs sm:text-sm font-black text-[#1a1a1a] line-clamp-2 leading-snug">
                      ${card.question}
                    </p>
                    <span class="inline-block mt-1.5 text-[11px] font-black text-[#0277bd] underline">
                      點擊放大檢視 🔍
                    </span>
                  </div>
                </div>
              </div>

            </div>
          </div>
        `;
      }).join('');
    }

    /* =========================================================================
       5. GROUP & CARD INTERACTION HANDLERS
       ========================================================================= */
    function selectGroup(groupId) {
      sfx.playSelectGroup();
      state.selectedGroupId = groupId;
      renderGroups();
    }

    function addGroup() {
      if (state.groups.length >= 10) return;
      sfx.playPop();
      const nextNum = state.groups.length + 1;
      const newId = Date.now();
      state.groups.push({ id: newId, name: `第 ${nextNum} 組`, drawnCardId: null });
      state.selectedGroupId = newId;
      renderGroups();
    }

    function removeGroup() {
      if (state.groups.length <= 2) return;
      sfx.playPop();
      const removed = state.groups.pop();
      // Free up any card drawn by the removed group
      if (removed && removed.drawnCardId) {
        delete state.drawnByGroup[removed.drawnCardId];
      }
      if (state.selectedGroupId === removed.id) {
        state.selectedGroupId = state.groups[state.groups.length - 1].id;
      }
      renderGroups();
      renderCards();
    }

    function handleCardClick(cardId) {
      const existingOwnerId = state.drawnByGroup[cardId];

      // Case 1: Card is already drawn -> Open modal to review question & timer
      if (existingOwnerId) {
        sfx.playPop();
        openFocusModal(cardId, existingOwnerId);
        return;
      }

      // Case 2: Card is face-down -> Check if current group already drew a card
      const currentGroup = state.groups.find(g => g.id === state.selectedGroupId);
      if (!currentGroup) return;

      if (currentGroup.drawnCardId) {
        // Find next group that hasn't drawn yet, or notify user
        const nextUndrawnGroup = state.groups.find(g => !g.drawnCardId);
        if (nextUndrawnGroup) {
          showDialog({
            icon: '💡',
            title: `${currentGroup.name} 已經抽過題目囉！`,
            message: `「${currentGroup.name}」已經抽中第 ${currentGroup.drawnCardId} 題。是否自動切換至尚未抽卡的「${nextUndrawnGroup.name}」？`,
            confirmText: `切換至 ${nextUndrawnGroup.name}`,
            confirmColor: 'bg-[#ffe066] text-[#1a1a1a]',
            onConfirm: () => {
              state.selectedGroupId = nextUndrawnGroup.id;
              renderGroups();
              closeDialog();
            }
          });
        } else {
          showDialog({
            icon: '🌟',
            title: '所有小組都已抽完題目！',
            message: '您可以點擊已翻開的卡片檢視題目，或點擊「全部重置」重新開始新一輪抽卡。',
            confirmText: '知道了',
            confirmColor: 'bg-[#81d4fa] text-[#1a1a1a]',
            hideCancel: true,
            onConfirm: () => closeDialog()
          });
        }
        return;
      }

      // Assign card to current group & flip!
      currentGroup.drawnCardId = cardId;
      state.drawnByGroup[cardId] = currentGroup.id;

      // Flip animation & lively celebratory sound + confetti
      const cardEl = document.getElementById(`card-el-${cardId}`);
      if (cardEl) {
        cardEl.classList.add('is-flipped');
      }
      sfx.playCardReveal();
      launchConfetti();

      // Re-render groups & cards after flip starts, then open focus modal smoothly
      setTimeout(() => {
        renderGroups();
        renderCards();
        // Reset timer to 5:00 for the newly drawn group discussion
        resetTimer(DEFAULT_SECONDS, false);
        openFocusModal(cardId, currentGroup.id);

        // Automatically advance selection pointer to next undrawn group for convenience
        const nextGroup = state.groups.find(g => !g.drawnCardId);
        if (nextGroup) {
          state.selectedGroupId = nextGroup.id;
          renderGroups();
        }
      }, 520);
    }

    function shuffleCards() {
      sfx.playShuffle();
      // Fisher-Yates shuffle on deckOrder
      for (let i = state.deckOrder.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [state.deckOrder[i], state.deckOrder[j]] = [state.deckOrder[j], state.deckOrder[i]];
      }
      renderCards(true);
      setTimeout(() => {
        renderCards(false);
      }, 680);
    }

    function confirmResetAll() {
      sfx.playPop();
      showDialog({
        icon: '🔄',
        title: '確定要全部重置嗎？',
        message: '這將會清除所有小組的抽卡紀錄、重設 5 分鐘計時器，並將五張卡片重新蓋上洗牌！',
        confirmText: '確定重置',
        confirmColor: 'bg-[#ef5350] text-white',
        onConfirm: () => {
          state.groups.forEach(g => (g.drawnCardId = null));
          state.drawnByGroup = {};
          state.selectedGroupId = state.groups[0].id;
          resetTimer(DEFAULT_SECONDS, false);
          closeDialog();
          renderGroups();
          shuffleCards();
        }
      });
    }

    /* =========================================================================
       6. FOCUS MODAL (ENLARGED DISCUSSION CARD VIEW)
       ========================================================================= */
    function openFocusModal(cardId, groupId) {
      const card = CARDS_DATA.find(c => c.id === cardId);
      const group = state.groups.find(g => g.id === groupId);
      if (!card) return;

      state.activeModalCardId = cardId;

      const modal = document.getElementById('focus-modal');
      const modalCard = document.getElementById('focus-modal-card');
      const groupBadge = document.getElementById('modal-group-badge');
      const numBadge = document.getElementById('modal-card-number-badge');
      const illustrationEl = document.getElementById('modal-illustration');
      const questionEl = document.getElementById('modal-question-text');

      modalCard.style.backgroundColor = card.borderColor;
      groupBadge.textContent = group ? `${group.name} 討論題目` : '小組討論題目';
      numBadge.textContent = `題卡 #${card.numberLabel}`;
      illustrationEl.innerHTML = card.svg;
      questionEl.textContent = card.question;

      // Match illustration left/right visual balance from uploaded slides
      if (card.illustrationPos === 'right') {
        illustrationEl.classList.add('md:order-2');
        document.getElementById('modal-question-wrapper').classList.add('md:order-1');
      } else {
        illustrationEl.classList.remove('md:order-2');
        document.getElementById('modal-question-wrapper').classList.remove('md:order-1');
      }

      modal.classList.remove('hidden');
      updateTimerDisplays();
    }

    function openTimerOnlyModal() {
      // If any card is drawn, show the most recently drawn card, otherwise card 1 preview
      const drawnIds = Object.keys(state.drawnByGroup).map(Number);
      const targetCardId = drawnIds.length > 0 ? drawnIds[drawnIds.length - 1] : state.deckOrder[0];
      const ownerId = state.drawnByGroup[targetCardId] || state.selectedGroupId;
      sfx.playPop();
      openFocusModal(targetCardId, ownerId);
    }

    function closeFocusModal() {
      sfx.playPop();
      document.getElementById('focus-modal').classList.add('hidden');
      state.activeModalCardId = null;
    }

    /* =========================================================================
       7. 5-MINUTE COUNTDOWN TIMER ENGINE
       ========================================================================= */
    function formatTime(sec) {
      const safeSec = Math.max(0, sec);
      const m = Math.floor(safeSec / 60);
      const s = safeSec % 60;
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    }

    function updateTimerDisplays() {
      const formatted = formatTime(timerState.remainingSeconds);
      const modalDisplay = document.getElementById('modal-timer-display');
      const miniDisplay = document.getElementById('mini-timer-display');
      const ring = document.getElementById('timer-ring');

      modalDisplay.textContent = formatted;
      miniDisplay.textContent = formatted;

      // Update circular SVG progress ring (circumference = 2 * pi * 26 ≈ 163.36)
      const circumference = 163.36;
      const ratio = timerState.totalSeconds > 0 ? timerState.remainingSeconds / timerState.totalSeconds : 0;
      const offset = circumference * (1 - Math.max(0, Math.min(1, ratio)));
      ring.style.strokeDashoffset = offset;

      // Color shifts: Mint/Green -> Amber -> Urgent Pulsing Red in last 30s
      if (timerState.remainingSeconds <= 30 && timerState.remainingSeconds > 0) {
        ring.style.stroke = '#ef5350';
        modalDisplay.classList.add('timer-urgent');
        miniDisplay.classList.add('timer-urgent');
      } else if (timerState.remainingSeconds <= 60 && timerState.remainingSeconds > 30) {
        ring.style.stroke = '#ffa726';
        modalDisplay.classList.remove('timer-urgent');
        miniDisplay.classList.remove('timer-urgent');
      } else {
        ring.style.stroke = '#26a69a';
        modalDisplay.classList.remove('timer-urgent');
        miniDisplay.classList.remove('timer-urgent');
      }

      // Sync button labels
      const startBtn = document.getElementById('modal-timer-start-btn');
      const btnIcon = document.getElementById('modal-timer-btn-icon');
      const btnText = document.getElementById('modal-timer-btn-text');
      const miniToggle = document.getElementById('mini-timer-toggle');

      if (timerState.isRunning) {
        btnIcon.textContent = '⏸️';
        btnText.textContent = '暫停計時';
        startBtn.classList.remove('bg-[#81c784]', 'hover:bg-[#66bb6a]');
        startBtn.classList.add('bg-[#ffab76]', 'hover:bg-[#ff9854]');
        miniToggle.textContent = '暫停';
        miniToggle.classList.remove('bg-[#ffe066]');
        miniToggle.classList.add('bg-[#ffab76]');
      } else {
        btnIcon.textContent = '▶️';
        btnText.textContent = timerState.remainingSeconds === 0 ? '重新開始' : '開始計時';
        startBtn.classList.remove('bg-[#ffab76]', 'hover:bg-[#ff9854]');
        startBtn.classList.add('bg-[#81c784]', 'hover:bg-[#66bb6a]');
        miniToggle.textContent = '開始';
        miniToggle.classList.remove('bg-[#ffab76]');
        miniToggle.classList.add('bg-[#ffe066]');
      }
    }

    function toggleTimer() {
      if (timerState.isRunning) {
        pauseTimer();
        sfx.playTimerClick(false);
      } else {
        if (timerState.remainingSeconds <= 0) {
          timerState.remainingSeconds = timerState.totalSeconds || DEFAULT_SECONDS;
        }
        startTimer();
        sfx.playTimerClick(true);
      }
    }

    function startTimer() {
      if (timerState.isRunning) return;
      timerState.isRunning = true;
      updateTimerDisplays();

      timerState.intervalId = setInterval(() => {
        if (timerState.remainingSeconds > 0) {
          timerState.remainingSeconds -= 1;
          updateTimerDisplays();

          // Final 10 seconds tick-tock warning
          if (timerState.remainingSeconds <= 10 && timerState.remainingSeconds > 0) {
            sfx.playTick(timerState.remainingSeconds % 2 === 0);
          }

          // Time's up!
          if (timerState.remainingSeconds === 0) {
            pauseTimer();
            sfx.playTimesUpFanfare();
            launchConfetti();
          }
        } else {
          pauseTimer();
        }
      }, 1000);
    }

    function pauseTimer() {
      timerState.isRunning = false;
      if (timerState.intervalId) {
        clearInterval(timerState.intervalId);
        timerState.intervalId = null;
      }
      updateTimerDisplays();
    }

    function resetTimer(seconds = DEFAULT_SECONDS, playSound = true) {
      pauseTimer();
      timerState.totalSeconds = seconds;
      timerState.remainingSeconds = seconds;
      if (playSound) sfx.playPop();
      updateTimerDisplays();
    }

    function adjustTimer(deltaSeconds) {
      sfx.playPop();
      const nextVal = Math.max(10, timerState.remainingSeconds + deltaSeconds);
      timerState.remainingSeconds = nextVal;
      if (nextVal > timerState.totalSeconds) {
        timerState.totalSeconds = nextVal;
      }
      updateTimerDisplays();
    }

    /* =========================================================================
       8. CUSTOM DIALOG & CELEBRATION CONFETTI
       ========================================================================= */
    function showDialog({ icon, title, message, confirmText, confirmColor, hideCancel = false, onConfirm }) {
      const dialog = document.getElementById('dialog-modal');
      document.getElementById('dialog-icon').textContent = icon;
      document.getElementById('dialog-title').textContent = title;
      document.getElementById('dialog-message').textContent = message;

      const cancelBtn = document.getElementById('dialog-cancel-btn');
      cancelBtn.style.display = hideCancel ? 'none' : 'inline-block';

      const confirmBtn = document.getElementById('dialog-confirm-btn');
      confirmBtn.textContent = confirmText;
      confirmBtn.className = `doodle-btn px-5 py-2.5 text-base ${confirmColor}`;
      confirmBtn.onclick = onConfirm;

      dialog.classList.remove('hidden');
    }

    function closeDialog() {
      document.getElementById('dialog-modal').classList.add('hidden');
    }

    // Lightweight hand-drawn style Confetti Burst
    function launchConfetti() {
      const canvas = document.getElementById('confetti-canvas');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const colors = ['#f48fb1', '#ffe066', '#29b6f6', '#ef5350', '#ffab76', '#81c784'];
      const particles = Array.from({ length: 75 }, () => ({
        x: canvas.width / 2 + (Math.random() - 0.5) * 240,
        y: canvas.height / 2 - 40,
        vx: (Math.random() - 0.5) * 18,
        vy: (Math.random() - 1.1) * 16 - 4,
        size: Math.random() * 10 + 7,
        color: colors[Math.floor(Math.random() * colors.length)],
        rot: Math.random() * Math.PI * 2,
        vRot: (Math.random() - 0.5) * 0.25,
        shape: Math.random() > 0.5 ? 'rect' : 'circle'
      }));

      let frame = 0;
      function animateConfetti() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let active = false;

        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.55; // gravity
          p.vx *= 0.98;
          p.rot += p.vRot;

          if (p.y < canvas.height + 30) {
            active = true;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = p.color;
            ctx.strokeStyle = '#1a1a1a';
            ctx.lineWidth = 2;

            if (p.shape === 'rect') {
              ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
              ctx.strokeRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
            } else {
              ctx.beginPath();
              ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
              ctx.fill();
              ctx.stroke();
            }
            ctx.restore();
          }
        });

        frame++;
        if (active && frame < 140) {
          requestAnimationFrame(animateConfetti);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
        }
      }

      requestAnimationFrame(animateConfetti);
    }

    // Keyboard ESC to close focus modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (!document.getElementById('dialog-modal').classList.contains('hidden')) {
          closeDialog();
        } else if (!document.getElementById('focus-modal').classList.contains('hidden')) {
          closeFocusModal();
        }
      }
    });

    // Initial Render
    window.addEventListener('DOMContentLoaded', () => {
      renderGroups();
      renderCards();
      updateTimerDisplays();
    });
  </script>
